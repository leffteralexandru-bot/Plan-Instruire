{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|docs/|assets/|icons/|brand/|sw\\.js|workbox|manifest\\.webmanifest|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [{ "path": "/api/cron-hr-alerts", "schedule": "0 6 * * *" }]
}
